# Finch.ai Configuration Template
# Copy this file to .env and adjust values as needed.

# ==============================================================================
# Model Providers & API Keys
# ==============================================================================
# Default Provider: 'ollama', 'gemini', or 'openai'
DEFAULT_PROVIDER=ollama

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# OpenAI & OpenAI-Compatible API Configuration
# Works with OpenAI, vLLM, LM Studio, Ollama (/v1), Groq, Together, OpenRouter, DeepSeek, etc.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Ollama Local LLM Configuration
OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=llama3.2:latest

# Request Timeout in seconds
REQUEST_TIMEOUT=120.0

# ==============================================================================
# In-Memory Context & Sliding Window
# ==============================================================================
# Sliding window size (number of dialogue messages retained in active buffer)
WINDOW_SIZE=8

# Personality markdown file path
PERSONALITY_FILE=personality.md

# Default system prompt fallback if personality.md is not found
SYSTEM_PROMPT="You are Finch.ai, a helpful, concise, and accurate AI assistant. Provide clear and direct answers."

# ==============================================================================
# Assistant Modes & Multi-Turn Agent Loop
# ==============================================================================
# Default assistant mode: 'chat' or 'agent'
DEFAULT_MODE=chat

# Maximum autonomous turns in Agent Mode before returning control to user
AGENT_MAX_TURNS=10

# Granular Agent Mode Tool Toggles (true/false)
ENABLE_TERMINAL_TOOL=true
ENABLE_PYTHON_TOOL=true
ENABLE_WEB_TOOL=false
ENABLE_FILE_TOOLS=true

# Shell command execution timeout in seconds
TERMINAL_TIMEOUT=30.0

# ==============================================================================
# Headroom Context Compression Pipeline
# ==============================================================================
COMPRESSION_ENABLED=true
COMPRESSION_MIN_TOKENS=100
COMPRESSION_PROTECT_RECENT=2
COMPRESS_USER_MESSAGES=true
COMPRESS_SYSTEM_MESSAGES=false

# ==============================================================================
# SQLite Storage, Archival & Columnar Compression
# ==============================================================================
DATABASE_PATH=conversations.db
AUTO_SUMMARIZE_ON_EXIT=true

# Column-level compression for message bodies in SQLite (zstd with zlib fallback)
COMPRESS_MESSAGE_BODIES=false
MESSAGE_COMPRESSION_THRESHOLD=1024

# ==============================================================================
# Vector Embeddings & Hybrid Search (sqlite-vec)
# ==============================================================================
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
RRF_K=60
